# Dependencies
# package-lock.json is intentionally committed: GitHub Marketplace Actions need
# a reproducible npm install in CI (`npm ci`), which requires the lockfile.
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.nyc_output/
*.lcov

# Development
.env.local
.env.*.local
.vscode/settings.json

# IDE
*.swo
*~
.vscode/

# OS

# Test artifacts (generated by test suite)
test/output/
dist/sitemap*.xml
dist/sitemap*.txt
dist/sitemap*.xml.gz

# Temporary files
*.tmp
*.temp


# >>> managed-file-sync:common >>>
# OS + editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Build + dependency output
node_modules/
dist/
build/
coverage/
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local secrets (never commit these)
.env
.env.*
!.env.example
