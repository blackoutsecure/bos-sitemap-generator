{
  "target_repo_role": "action-repository",
  "managed_file_sync": {
    "mode": "commit",
    "services": [
      "common",
      "lf_line_endings",
      "node_ecosystem"
    ]
  },
  "marketplace": {
    "enabled": true,
    "target_branch": "main",
    "allowlist_paths": [
      "action.yml",
      "dist",
      "src",
      "README.md",
      "LICENSE",
      "NOTICE",
      "package.json",
      "package-lock.json"
    ],
    "blocked_paths": [
      ".github/workflows/",
      ".editorconfig",
      ".gitattributes",
      ".gitignore",
      ".markdownlint.yaml",
      ".shellcheckrc",
      ".yamllint.yml",
      "test/"
    ],
    "required_paths": [
      ".github/dependabot.yml",
      "action.yml",
      "dist",
      "README.md",
      "LICENSE",
      "NOTICE",
      "package.json",
      "package-lock.json"
    ],
    "include_dependabot_config": true,
    "include_github_metadata": false,
    "repo_metadata": {
      "enable": true,
      "homepage": "https://github.com/marketplace/actions/blackout-secure-sitemap-generator",
      "ai_model": "auto",
      "description_mode": "auto",
      "description_fallback": "Generate standards-compliant XML sitemaps from a public site URL and publish them as a GitHub Action",
      "use_existing_readme": true,
      "generate_readme": false,
      "generate_topics": true,
      "topics_fallback": "github-actions sitemap xml seo website-automation composite-action devops",
      "categories": {
        "primary": "auto",
        "secondary": "auto"
      },
      "marketplace_slug": "blackout-secure-sitemap-generator"
    }
  }
}
